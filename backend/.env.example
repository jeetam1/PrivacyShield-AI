# ==============================================================================
# PRIVACYSHIELD AI - ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================
# This file defines all runtime environment variables used by the Django backend.
# In production (Render), set these under "Environment Variables" in the dashboard.
# For local development, copy this file to .env:  cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL / Supabase)
# ------------------------------------------------------------------------------
# WHY: Django needs to connect to an external PostgreSQL database (Supabase) to
# store registered user accounts, authentication records, and PII scan history.
#
# Option A: Full Connection String (Recommended for Render)
# Notice: If your password contains special characters (like '@'), URL-encode it (e.g. '@' -> '%40'):
DATABASE_URL=postgresql://postgres:<YOUR_ENCODED_PASSWORD>@db.fufmokwnlzzkachpoyhc.supabase.co:5432/postgres

# Option B: Individual Database Parameters (Alternative fallback)
DB_HOST=db.fufmokwnlzzkachpoyhc.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=<YOUR_DB_PASSWORD>


# ------------------------------------------------------------------------------
# 2. DJANGO CORE SECURITY SETTINGS
# ------------------------------------------------------------------------------
# SECRET_KEY:
# WHY: Cryptographic signing key used by Django to sign session cookies, CSRF
# tokens, and password reset tokens. In production, this must remain secret.
SECRET_KEY=django-insecure-privacyshield-production-key-change-in-production

# DJANGO_DEBUG:
# WHY: Enables detailed interactive error pages with full traceback when True.
# In production on Render, ALWAYS set this to 'False' so attackers cannot see
# database schema or internal system paths on server errors.
DJANGO_DEBUG=False

# PYTHON_VERSION:
# WHY: Specifies the exact Python runtime version Render builds the environment with.
PYTHON_VERSION=3.12.0


# ------------------------------------------------------------------------------
# 3. NETWORK & HOST ROUTING
# ------------------------------------------------------------------------------
# ALLOWED_HOSTS:
# WHY: Prevents HTTP Host Header attacks. Django will reject any incoming request
# whose 'Host' header does not match one of these domains.
# In Render, '.onrender.com' allows your app to receive requests at your Render URL.
ALLOWED_HOSTS=.onrender.com,localhost,127.0.0.1


# ------------------------------------------------------------------------------
# 4. CROSS-ORIGIN RESOURCE SHARING (CORS)
# ------------------------------------------------------------------------------
# CORS_ALLOW_ALL_ORIGINS:
# WHY: Allows frontend web applications (like your React app deployed on Vercel
# or running on localhost:5173) to make API requests to this Django backend.
CORS_ALLOW_ALL_ORIGINS=True

# CORS_ALLOWED_ORIGINS:
# WHY: If you want strict origin whitelisting instead of allowing all origins,
# specify comma-separated allowed frontend URLs here:
CORS_ALLOWED_ORIGINS=https://privacy-shield-ai-ten.vercel.app,http://localhost:5173,http://localhost:3000
