# ==========================================
# PrivacyShield-AI - Root Git Ignore
# ==========================================

# Binaries & Executables
*.exe
cli_v2*.exe

# Python Cache & Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so

# Python Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Django Build, Database & Uploads
backend/db.sqlite3
backend/db.sqlite3-journal
backend/staticfiles/
backend/media/uploads/*
!backend/media/uploads/.gitkeep
backend/media/*
!backend/media/.gitkeep
*.sqlite3
staticfiles/

# Environment Variables
.env
.env.*
!.env.example

# Node / Frontend
node_modules/
dist/
dist-ssr/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# IDE & Editor Files
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db
