# ==============================================================================
# PRIVACYSHIELD AI - FRONTEND ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================
# For Vercel Deployment:
# Add this variable under Vercel Project Settings > Environment Variables.
#
# For Local Development:
# Copy this file to .env:  cp .env.example .env
# ==============================================================================

# Backend API Base URL (Must include the trailing slash '/'):
# Local Development:
# VITE_API_URL=http://127.0.0.1:8000/api/

# Production on Render:
VITE_API_URL=https://<YOUR_RENDER_SERVICE_NAME>.onrender.com/api/
